# Copy to .env and adjust. .env is gitignored.
#   cp .env.example .env

# --- Local AWS surface (floci) ---------------------------------------------
# These are fake credentials for the local emulator. They are not secrets and
# they never reach real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Local infrastructure ---------------------------------------------------
KAFKA_BOOTSTRAP=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
DATABASE_URL=postgres://platform:platform@localhost:5432/platform?sslmode=disable

# --- Resource names ---------------------------------------------------------
# What the smoke checks look for. Defaults match local/bootstrap/seed.sh; set
# these to point at Terraform-created resources when running against real AWS.
MLP_BUCKET=mlp-artifacts
MLP_TOPIC=mlp-events
MLP_QUEUE=mlp-events-q
MLP_KAFKA_TOPIC=mlp.events
MLP_RELAY_DLQ_TOPIC=mlp.relay.deliveries.dlq
# relay and its sink, from the `apps` compose profile. Set RELAY_INGEST_URL
# empty to skip the relay smoke check on a stack without that profile.
RELAY_INGEST_URL=http://localhost:8082
SINK_URL=http://localhost:8084
MLP_SES_SENDER=platform@localhost.test

# --- Telemetry --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=smoke

# Datadog is optional. Leave DD_API_KEY empty to run fully local against
# Prometheus/Tempo/Grafana. Set it, then enable the datadog exporter in
# local/config/otel/config.yaml, to ship the same telemetry to Datadog.
DD_API_KEY=
DD_SITE=datadoghq.com

# --- Real AWS (only used by the aws-* make targets) -------------------------
AWS_PROFILE_NAME=aws-public-change-feed

# Point the smoke checks at the REAL account instead of the local emulator.
# This is the only thing that does so: an empty AWS_ENDPOINT_URL still means
# "local", so a stray `export AWS_ENDPOINT_URL=` cannot hit a live account by
# accident. Requires resources to exist -- see docs/runbook-local.md.
#   MLP_USE_REAL_AWS=1
