# Secrets -- never commit
.env
*.pem
*.key
credentials

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# tfvars often carry account ids / real values; commit .example instead
*.tfvars
!*.tfvars.example

# Go
bin/
dist/
*.test
*.out
vendor/
# Compiled service binaries. In a module whose only package is main --
# services/echo and services/sink -- `go build ./...` writes the executable
# beside the source, named after the last element of the module path rather
# than the directory. services/sink/sink was committed that way in cccef79.
# relay and smoke keep main under cmd/, so a whole-module build discards the
# executable, but `go build ./cmd/relay` from the module root still writes one.
# Nothing consumes these: the Dockerfiles build from source inside the image.
# One line per module, because a gitignore pattern cannot match "the directory
# name repeated"; add a line when a service is added.
/services/echo/echo
/services/relay/relay
/services/sink/sink
/services/smoke/smoke

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local scratch
tmp/
.evidence/

# Agent tooling caches -- machine-local indexes, not shareable state.
# .codegraph/ has its own .gitignore that keeps only that file.
.token-savior-cache.json
.semble/
.aider*

# Claude Code local overrides. .claude/settings.json IS committed (shared
# project config); settings.local.json is personal and is not.
.claude/settings.local.json
